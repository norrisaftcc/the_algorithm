{
  "name": "@the-algorithm/core",
  "version": "0.1.0",
  "description": "Learning velocity gamification platform with security-first architecture",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "security:scan": "npm audit && snyk test",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "clean": "rm -rf dist coverage .turbo",
    "precommit": "lint-staged",
    "prepare": "husky install"
  },
  "dependencies": {
    "@fastify/autoload": "^5.8.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/swagger": "^8.14.0",
    "@prisma/client": "^5.11.0",
    "bullmq": "^5.7.1",
    "effect": "^3.0.0",
    "fastify": "^4.26.2",
    "fp-ts": "^2.16.5",
    "ioredis": "^5.3.2",
    "pino": "^8.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@vitest/coverage-v8": "^1.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-functional": "^6.5.1",
    "fast-check": "^3.17.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "prisma": "^5.11.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.9",
    "vitest": "^1.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/norrisa/the_algorithm.git"
  },
  "keywords": [
    "gamification",
    "learning",
    "velocity",
    "education",
    "typescript",
    "functional-programming"
  ],
  "author": "The Algorithm Team",
  "license": "MIT"
}